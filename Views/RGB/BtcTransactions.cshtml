@model RGBBtcTransactionsViewModel
@{
    ViewData["Title"] = "BTC Transactions";
}

<div class="sticky-header-setup"></div>
<partial name="_RgbCustodialBanner" />
<div class="sticky-header d-flex align-items-center justify-content-between">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Index" asp-route-storeId="@Model.StoreId" class="btn btn-secondary">
        <span class="fa fa-arrow-left"></span> Back
    </a>
</div>

<partial name="_StatusMessage" />

@if (Model.Transactions.Any())
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Txid</th>
                    <th class="text-end">Amount</th>
                    <th class="text-end">Fee</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tx in Model.Transactions)
                {
                    var net = tx.Received - tx.Sent;
                    var isPositive = net >= 0;
                    var isConfirmed = tx.Height.HasValue;
                    var amountBtc = Math.Abs(net) / 100_000_000m;
                    <tr>
                        <td>
                            @if (tx.Timestamp.HasValue)
                            {
                                @tx.Timestamp.Value.ToString("yyyy-MM-dd HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">Pending</span>
                            }
                        </td>
                        <td>
                            @if (tx.Type == "Create UTXOs")
                            {
                                <span class="badge bg-info">@tx.Type</span>
                            }
                            else if (tx.Type == "RGB Send")
                            {
                                <span class="badge bg-primary">@tx.Type</span>
                            }
                            else if (tx.Type == "Drain")
                            {
                                <span class="badge bg-warning">@tx.Type</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@tx.Type</span>
                            }
                        </td>
                        <td><code class="small text-break">@tx.Txid</code></td>
                        <td class="text-end">
                            <span class="text-@(isPositive ? "success" : "danger")@(isConfirmed ? "" : " opacity-50")">
                                @(isPositive ? "+" : "-")@amountBtc.ToString("0.########") BTC
                            </span>
                            <br />
                            <small class="text-muted">@(isPositive ? "+" : "-")@Math.Abs(net).ToString("N0") sats</small>
                        </td>
                        <td class="text-end@(isConfirmed ? "" : " opacity-50")">
                            <span class="text-muted">@tx.Fee.ToString("N0") sats</span>
                        </td>
                        <td>
                            @if (isConfirmed)
                            {
                                <span class="badge bg-success">Confirmed</span>
                                <br /><small class="text-muted">Block @tx.Height!.Value.ToString("N0")</small>
                            }
                            else
                            {
                                <span class="badge bg-warning">Unconfirmed</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        No BTC transactions yet. Transactions will appear here after funding the wallet or creating UTXOs.
    </div>
}
