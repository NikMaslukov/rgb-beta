@model RGBTransfersViewModel
@{
    ViewData["Title"] = "RGB Transfers";
}

<div class="sticky-header-setup"></div>
<partial name="_RgbCustodialBanner" />
<div class="sticky-header d-flex align-items-center justify-content-between">
    <h2>@ViewData["Title"]</h2>
    <div class="d-flex gap-2">
        <a asp-action="SendAsset" asp-route-storeId="@Model.StoreId" class="btn btn-primary">
            <span class="fa fa-paper-plane"></span> Send Asset
        </a>
        <a asp-action="Index" asp-route-storeId="@Model.StoreId" class="btn btn-secondary">
            <span class="fa fa-arrow-left"></span> Back
        </a>
    </div>
</div>

<partial name="_StatusMessage" />

@if (Model.Transfers.Any())
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Asset</th>
                    <th>Type</th>
                    <th>Amount</th>
                    <th>Transaction</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transfer in Model.Transfers.OrderByDescending(t => t.Idx))
                {
                    var isSend = transfer.Kind == "Send";
                    var isSettled = transfer.Status == "Settled";
                    <tr>
                        <td><span class="badge bg-primary">@transfer.AssetTicker</span></td>
                        <td>
                            @if (isSend)
                            {
                                <span class="badge bg-danger">@transfer.Kind</span>
                            }
                            else if (transfer.Kind == "Issuance")
                            {
                                <span class="badge bg-info">@transfer.Kind</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@transfer.Kind</span>
                            }
                        </td>
                        <td>
                            <span class="@(isSend ? "text-danger" : "text-success")@(isSettled ? "" : " opacity-50")">
                                @(isSend ? "-" : "+")@transfer.Amount.ToString("N0")
                            </span>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(transfer.Txid))
                            {
                                <code class="small text-break">@transfer.Txid</code>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (isSettled)
                            {
                                <span class="badge bg-success">@transfer.Status</span>
                            }
                            else if (transfer.Status == "Failed")
                            {
                                <span class="badge bg-danger">@transfer.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">@transfer.Status</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        No transfers yet. Transfers will appear here when you send or receive RGB assets.
    </div>
}
